{
  "uid": "kong-alemana",
  "title": "Kong Alemana",
  "description": "Estado operativo de Kong, ordenado por las preguntas que hace un administrador. Ver el panel de notas al pie: el plugin de Prometheus no cubre el tráfico de Internet.",
  "tags": [
    "kong",
    "api-gateway",
    "soc"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ],
    "time_options": [
      "15m",
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "refresh": "1m",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat",
      "title": "Kong",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Prometheus alcanza el endpoint de metricas de Kong (:8100).",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"kong\"}",
          "legendFormat": "__auto",
          "refId": "C",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CAIDO",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "ARRIBA",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
